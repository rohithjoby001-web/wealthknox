# Copy this file to .env.local (Vite loads that automatically, and it's
# already covered by .gitignore so your keys never get committed) and fill
# in the values from your Firebase project's web app config.
#
# Where to get these: Firebase console -> Project settings -> General ->
# "Your apps" -> the web app (</>) you registered -> SDK setup and
# configuration -> Config.
#
# Leave this file (and a missing .env.local) alone and the app runs in
# local-only mode exactly as before — no account, no sync, data stays in
# this browser's storage. Nothing breaks if you don't set these up.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
